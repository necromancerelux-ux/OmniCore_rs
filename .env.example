# Copy to .env and fill in. NEVER commit .env.
DISCORD_BOT_TOKEN=
OWNER_ID=
# DISCORD_GUILD_ID=            # dev only: instant command registration in one guild
# Music is OFF unless LAVALINK_HOST is set. Only set it if a Lavalink server is really
# running/reachable (Node panels usually have none: leave it out, or use a hosted node).
# LAVALINK_HOST=127.0.0.1:2333
# LAVALINK_PASSWORD=           # required unless Lavalink is on localhost
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost   # Google blocks the old urn:ietf:wg:oauth:2.0:oob flow
# Needs "Message Content Intent" enabled in the Discord developer portal (WoS relay).
# OMNICORE_SECRET_KEY=          # long random string: encrypts stored credentials (Oracle, WoS key, Google) at rest.
#                               # Keep it ONLY in the host environment. If you lose it, reconnect those services.
# EMOJI_GUILD_ID=               # optional: force the home server for custom material emoji.
#                               # If unset, the first server the bot is in is auto-picked.

# --- TLS / network (only if you see `invalid peer certificate: UnknownIssuer`) ---
# OMNICORE_CA_FILE=/etc/ssl/certs/ca-certificates.crt   # extra trusted CA bundle
# OMNICORE_NO_PROXY=1                                   # ignore HTTP(S)_PROXY from the host
# OMNICORE_INSECURE_TLS=1                               # last resort: skip cert checks
